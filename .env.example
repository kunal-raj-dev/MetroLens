# MetroLens MVP. Copy to .env for docker compose; keep real keys out of git.
# Generate a random secret of at least 32 bytes. The API fails closed if absent.
METROLENS_API_KEY=
METROLENS_CORS_ORIGINS=https://metrolens.netlify.app,http://localhost:3000,http://127.0.0.1:3000
# Dedicated private directory. Records expire after one hour; disk cleanup is periodic.
METROLENS_SPOOL_DIR=
# Optional absolute model root (must contain weights/ocr/*). Default: ./models
METROLENS_MODELS_DIR=
# Public URL is bundled during the web BUILD. HTTPS required for a hosted site.
# Leave empty on Netlify for demo-only use until a separate API is deployed.
NEXT_PUBLIC_API_URL=
