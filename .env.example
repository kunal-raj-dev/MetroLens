# Nirikshak System Configuration Environment Template

# System Environment (development | staging | production)
NIRIKSHAK_ENV=development
NIRIKSHAK_LOG_LEVEL=INFO

# Inspection Service API
API_HOST=0.0.0.0
API_PORT=8000
API_SECRET_KEY=CHANGE_THIS_IN_PRODUCTION_SECRET_KEY_MIN_32_CHARS
API_JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=480

# Database (PostgreSQL)
POSTGRES_USER=nirikshak_admin
POSTGRES_PASSWORD=CHANGE_THIS_IN_PRODUCTION_POSTGRES_PASSWORD
POSTGRES_DB=nirikshak_db
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
DATABASE_URL=postgresql+asyncpg://${POSTGRES_USER}:${POSTGRES_PASSWORD}@${POSTGRES_HOST}:${POSTGRES_PORT}/${POSTGRES_DB}

# Storage (Local or S3-compatible Object Storage for Evidence Dossiers)
STORAGE_BACKEND=local
LOCAL_STORAGE_PATH=./data/evidence_store
S3_ENDPOINT_URL=
S3_BUCKET_NAME=nirikshak-evidence
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_REGION=ap-south-1

# Inference Engine Configuration
VISION_MODEL_BACKEND=paddleocr
VISION_DEVICE=cpu
ENABLE_GPU_INFERENCE=false
IMAGE_QUALITY_BLUR_THRESHOLD=100.0
CALIBRATION_DEFAULT_REFERENCE_MM=TBD_SPECIFY_TARGET_MM

# Regulatory Snapshots
REGULATIONS_ROOT_PATH=./regulations
RULES_ROOT_PATH=./rules
DATA_MANIFEST_PATH=./data/manifests/manifest.yaml

# Security & Compliance
ENABLE_AUDIT_LOG_HASHING=true
REQUIRE_PHYSICAL_CALIBRATION=true
ALLOW_UNVERIFIED_RULES=false
