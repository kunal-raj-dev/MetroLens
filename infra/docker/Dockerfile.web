# Nirikshak Web UI Container — DEVELOPMENT SCAFFOLD (PRE-IMPLEMENTATION)
# Production container hardening and static optimization to be finalized during Phase 2 implementation.

FROM node:20-alpine

WORKDIR /app

COPY apps/web/package.json* ./
RUN if [ -f package.json ]; then npm install; fi

COPY . /app

EXPOSE 3000

CMD ["npm", "run", "dev"]
